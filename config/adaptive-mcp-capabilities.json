{
  "servers": [
    {
      "id": "grafana-query",
      "name": "Grafana Metadata and Query Read Boundary",
      "url_env": "GRAFANA_QUERY_MCP_URL",
      "local_url": "http://127.0.0.1:8772/mcp",
      "enabled_tools": ["discover_datasets", "inspect_dataset", "query_dataset"],
      "disabled_tools": []
    },
    {
      "id": "sandbox-analysis",
      "name": "Isolated Dynamic Python Analysis",
      "url_env": "SANDBOX_ANALYSIS_MCP_URL",
      "local_url": "http://127.0.0.1:8777/mcp",
      "enabled_tools": ["reconcile_operation", "execute_python_analysis", "execute_python_preprocessing", "build_simulator_model", "list_python_analyses", "inspect_python_analysis", "revise_python_analysis"],
      "disabled_tools": []
    },
    {
      "id": "artifact-bridge",
      "name": "Authorized Artifact Binding Bridge",
      "url_env": "ARTIFACT_BRIDGE_MCP_URL",
      "local_url": "http://127.0.0.1:8773/mcp",
      "enabled_tools": ["resolve_dashboard_refs", "grant_artifact_reuse"],
      "disabled_tools": []
    }
  ]
}
